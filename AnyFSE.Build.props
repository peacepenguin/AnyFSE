<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared build-speed settings. Import after Microsoft.Cpp.props:
    <Import Project="AnyFSE.Build.props" />
  Projects that opt in to the precompiled header set <UsePch>true</UsePch> before the import.
  Release builds only use whole program optimization (/GL + /LTCG) when -p:Lto=true is passed (the release workflow does this).
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <LinkIncremental>true</LinkIncremental>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <!-- Zydis and Zycore are compiled into each binary from src/Tools/zydis (vendored amalgamation), not used as DLLs. -->
      <PreprocessorDefinitions>ZYDIS_STATIC_BUILD;ZYCORE_STATIC_BUILD;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <MinimalRebuild>false</MinimalRebuild>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>DebugFastLink</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(UsePch)'=='true'">
    <ClCompile>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.hpp</PrecompiledHeaderFile>
      <ForcedIncludeFiles>pch.hpp</ForcedIncludeFiles>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup Condition="'$(UsePch)'=='true'">
    <ClCompile Include="$(MSBuildThisFileDirectory)src\pch.cpp">
      <PrecompiledHeader>Create</PrecompiledHeader>
    </ClCompile>
  </ItemGroup>
</Project>
